DATABASE_URL=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Repository indexing + chat (embeddings are 512-dim; the Pinecone index must match)
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=

# Inngest: not needed locally with `npx inngest-cli@latest dev`; set in production
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# GitHub webhooks (pull request live updates). Any random string; BETTER_AUTH_URL must be
# publicly reachable (use a tunnel locally) for GitHub to deliver events.
GITHUB_WEBHOOK_SECRET=
